# Database Configuration
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/gocart_db"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/gocart_db"

# NextAuth.js Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-this-in-production"

# App Configuration
NEXT_PUBLIC_CURRENCY_SYMBOL="$"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email Configuration
# For development, we'll use Ethereal Email (test emails)
# For production, use your SMTP provider (Gmail, SendGrid, etc.)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
FROM_EMAIL="noreply@gocart.com"
ADMIN_EMAIL="admin@example.com"

# Ethereal Email (for development testing)
ETHEREAL_USER="ethereal.user@ethereal.email"
ETHEREAL_PASS="ethereal.pass"

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key_here"
STRIPE_SECRET_KEY="sk_test_your_secret_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"
